# Copy to .env (never committed) and fill in.
ANTHROPIC_API_KEY=sk-ant-...
# The two people who share the app, comma separated.
FATTIES_PEOPLE=Polar,Partner
# claude (real photo analysis) or fake (fixed answer, no API call).
FATTIES_ANALYZER=claude
FATTIES_MODEL=claude-opus-5-5
FATTIES_EFFORT=medium

# Private photo storage: local for development, r2 for Cloudflare production.
# Switching backends does not copy old photos; see docs/widget-setup.md.
FATTIES_PHOTO_STORAGE=local
# FATTIES_PHOTO_DIR=data/photos
# FATTIES_PUBLIC_URL=https://fatties.example.com
# For r2: private bucket and a bucket-scoped Object Read & Write service credential.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
FATTIES_DB=data/fatties.db
FATTIES_TZ=Asia/Singapore

# Copy to .env (never committed) and fill in.
ANTHROPIC_API_KEY=sk-ant-...
# The two people who share the app, comma separated.
FATTIES_PEOPLE=Polar,Partner
# claude (real photo analysis) or fake (fixed answer, no API call).
FATTIES_ANALYZER=claude
FATTIES_MODEL=claude-opus-5-5
FATTIES_EFFORT=medium
FATTIES_DB=data/fatties.db
FATTIES_TZ=Asia/Singapore
